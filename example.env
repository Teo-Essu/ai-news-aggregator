OPENAI_API_KEY=

MY_EMAIL=
APP_PASSWORD=

# Preferred: full connection string (e.g. Supabase session pooler).
# Takes precedence over the POSTGRES_* vars below when set.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Local-dev fallback (used when DATABASE_URL is unset).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432